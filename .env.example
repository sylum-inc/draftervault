# Draft Vault Environment Configuration
# Copy this file to .env and fill in your values

# ===========================================
# REQUIRED - Application
# ===========================================

# Application environment (development, staging, production)
VITE_APP_ENV=development

# Base URL for the application
VITE_APP_URL=http://localhost:8080

# ===========================================
# REQUIRED - API Keys
# ===========================================

# RapidAPI key for NFL data
VITE_RAPIDAPI_KEY=your_rapidapi_key_here

# SportsData.io API key (premium stats)
VITE_SPORTSDATA_KEY=your_sportsdata_key_here

# ===========================================
# REQUIRED - Error Monitoring
# ===========================================

# Sentry DSN for error tracking
VITE_SENTRY_DSN=your_sentry_dsn_here

# ===========================================
# OPTIONAL - Real-time Features
# ===========================================

# WebSocket server URL for draft sync
VITE_WS_URL=wss://your-websocket-server.com

# ===========================================
# OPTIONAL - Analytics
# ===========================================

# Google Analytics measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# PostHog API key
VITE_POSTHOG_KEY=your_posthog_key_here

# ===========================================
# OPTIONAL - Feature Flags
# ===========================================

# Enable mock data mode (bypasses API calls)
VITE_USE_MOCK_DATA=false

# Enable debug logging
VITE_DEBUG=false

# Enable experimental features
VITE_ENABLE_EXPERIMENTS=false

# ===========================================
# OPTIONAL - The optional backend
# ===========================================
# These are read by `npm run server` (the Node process), NOT by the browser
# bundle. Nothing secret may ever be a VITE_* value: those are compiled into the
# bundle and readable by anyone who opens it. See docs/SERVER.md.

# Where the server listens. Anything but loopback requires a token, and the
# server refuses to start otherwise. A tunnel connects outward from this machine
# and reaches loopback fine, so you rarely want to change this.
DRAFT_VAULT_HOST=127.0.0.1
DRAFT_VAULT_PORT=8788

# Shared bearer token, required on every route but the handshake. Generate one
# per draft night: openssl rand -hex 24
DRAFT_VAULT_TOKEN=

# Where saved drafts and job output are written.
DRAFT_VAULT_DATA=.draft-vault-data

# Shown in the server panel, so two tunnels are tellable apart.
DRAFT_VAULT_NAME=

# CORS allowlist, comma separated. Unnecessary when the server serves dist/ —
# then the page and the API share an origin. Needed for `npm run dev` on :8080.
DRAFT_VAULT_ORIGINS=

# Enables the research job. Read by the server process and passed to the script
# it spawns; it is never returned by any route and never reaches the browser.
OPENROUTER_API_KEY=

# The address the built app should look for a server at. An address, not a
# credential. Leave unset: with nothing configured the app makes no request at
# all, which is the point. Only needed when the app is served from somewhere
# other than the server itself.
VITE_DRAFT_SERVER=
